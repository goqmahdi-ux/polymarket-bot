# --- Polymarket wallet (REQUIRED for live trading) ---
# Hex private key of the wallet that holds your USDC on Polygon.
# Leave blank to run in dry-run mode with public market data only.
POLYMARKET_PRIVATE_KEY=

# Only set this if you signed up to Polymarket via email/browser login (Magic).
# In that case POLYMARKET_PRIVATE_KEY is the signer key and
# POLYMARKET_FUNDER_ADDRESS is your Polymarket proxy wallet address.
# Leave blank for normal MetaMask-style EOA wallets.
POLYMARKET_FUNDER_ADDRESS=

# --- Trading mode ---
DRY_RUN=true
POLL_INTERVAL_SECONDS=60

# --- Strategy: buy YES tokens trading at or below MAX_YES_PRICE ---
MAX_YES_PRICE=0.15
MIN_YES_PRICE=0.03
ORDER_SIZE_USDC=5
MIN_MARKET_VOLUME=10000

# --- Take-profit: auto-sell open YES positions when price >= this ---
TAKE_PROFIT_PRICE=0.30

# --- Stop-loss: auto-sell open YES positions when price <= this ---
STOP_LOSS_PRICE=0.01

# --- Risk caps ---
MAX_OPEN_POSITIONS=10
MAX_DAILY_SPEND_USDC=50
MAX_ORDERS_PER_CYCLE=3

LOG_LEVEL=INFO
